{
  "name": "iou-exchange",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "echo Run npm run dev and npm run dev:api in two terminals",
    "build": "npx vite build",
    "typecheck": "tsc --noEmit",
    "build:check": "tsc --noEmit && vite build",
    "build:api": "echo API runs via tsx — no separate build required",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "start:static": "serve -s dist -l ${PORT:-3000}",
    "start:api": "tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit push",
    "db:migrate:sql": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:purge-demo": "tsx scripts/purge-demo-seed.ts",
    "db:setup": "drizzle-kit push && tsx server/db/seed.ts",
    "db:rls": "tsx server/db/apply-rls.ts",
    "db:setup:supabase": "tsx scripts/supabase-db-setup.ts",
    "db:teardown:supabase": "tsx scripts/supabase-teardown.ts",
    "render:env": "tsx scripts/set-render-env.ts",
    "db:apply:sql": "tsx scripts/apply-sql-file.ts",
    "db:ops:migration": "tsx scripts/apply-sql-file.ts supabase/migrations/20260721121000_ioux_ops_cron_and_webhook_columns.sql",
    "create-admin": "tsx scripts/create-admin.ts",
    "invite:users": "tsx scripts/invite-users.ts",
    "supabase:db:push": "supabase db push",
    "supabase:function:serve:webhook": "supabase functions serve afyax-payment-update",
    "supabase:function:deploy:webhook": "supabase functions deploy afyax-payment-update",
    "test:cross-tenant": "tsx scripts/security-cross-tenant.ts",
    "test:authz": "tsx scripts/security-authz-audit.ts",
    "smoke": "tsx scripts/smoke-uzima.ts",
    "smoke:dual": "tsx scripts/smoke-dual-origination.ts",
    "check:infra": "tsx scripts/check-infra.ts",
    "check:db": "tsx scripts/check-db-schema.ts",
    "verify:db": "tsx scripts/verify-db.ts",
    "emails:preview": "tsx scripts/render-email-previews.ts",
    "test": "vitest run server/__tests__/unit.test.ts",
    "test:integration": "vitest run server/__tests__/api.integration.test.ts",
    "test:all": "vitest run",
    "optimize:og": "node scripts/optimize-og-image.mjs",
    "compose:og": "node scripts/compose-og-image.mjs"
  },
  "dependencies": {
