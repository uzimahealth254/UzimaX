# Uzima API — copy to .env and fill values. Never commit real secrets.

NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://uzima:uzima@localhost:5432/uzima

# Required in production (≥32 random chars each). Generated ephemerally in development if missing.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated SPA origins (required; no wildcard in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Redis for distributed rate limits / lockout
REDIS_URL=

# Email: stub | resend | smtp
EMAIL_PROVIDER=stub
# ALLOW_DEMO_OTP=true only for local demos — never in real production
ALLOW_DEMO_OTP=true
DEMO_OTP=123456

# Demo seed password (local only)
DEMO_PASSWORD=Uzima2026!

# Simulated wallet minting — disabled automatically when NODE_ENV=production
# ENABLE_SIMULATED_WALLET=false

# Allow refresh token in JSON body (smoke tests / mobile). Prefer httpOnly cookie.
ALLOW_BODY_REFRESH=true

# AfyaX webhook HMAC (required in production)
# AFYAX_WEBHOOK_SECRET=

STORAGE_LOCAL_PATH=./storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
LOGIN_LOCKOUT_THRESHOLD=5
