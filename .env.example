# ============ API ============
NODE_ENV=production
PORT=8787
# Local Docker: postgresql://uzima:uzima@localhost:5432/uzima
# Hosted Supabase (session pooler for migrations): see .env.supabase after npm run db:setup:supabase
DATABASE_URL=postgresql://uzima:uzima@localhost:5432/uzima
JWT_SECRET=replace-with-openssl-rand-hex-48
JWT_REFRESH_SECRET=replace-with-another-openssl-rand-hex-48

# ============ Auth / demo ============
DEMO_PASSWORD=
ALLOW_DEMO_OTP=false
ALLOW_BODY_REFRESH=false
ENABLE_SIMULATED_WALLET=false
# Required true when serving over HTTPS
COOKIE_SECURE=true
CORS_ORIGINS=https://www.ioux.africa,https://ioux.africa,https://app.ioux.africa
# First real admin (never use db:seed in prod): ADMIN_EMAIL=… ADMIN_PASSWORD=… npm run create-admin
# Only set when intentionally seeding hosted DB
# ALLOW_PROD_SEED=1

# Production template: see .env.production.example (copy values into Render secrets)

# ============ Storage ============
STORAGE_LOCAL_PATH=./storage
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=uzima-documents
# S3_REGION=auto

# ============ Email (you configure — templates are ready) ============
EMAIL_PROVIDER=resend
# EMAIL_PROVIDER=smtp
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=IOU Exchange <no-reply@ioux.africa>
PORTAL_URL=https://app.ioux.africa
SUPPORT_EMAIL=hello@ioux.africa

# ============ SMS ============
SMS_PROVIDER=stub
# SMS_PROVIDER=africastalking
# AT_API_KEY=
# AT_USERNAME=
# AT_SENDER_ID=IOUX

# ============ Redis (required in production) ============
REDIS_URL=redis://localhost:6379
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MS=900000

# ============ AfyaX ============
# Inbound: AfyaX signs payment webhooks to IOUX
# AFYAX_WEBHOOK_SECRET=
# Outbound: IOUX → AfyaX (Admin → Integrations or npm run configure:afyax)
# IOUX_WEBHOOK_SECRET=
# AfyaX purchase webhook (Sule spec) — sandbox + production
# AFYAX_SANDBOX_BASE_URL=https://manager.smplystore.com
# AFYAX_PRODUCTION_BASE_URL=https://vendor.afyax.health
# AFYAX_SANDBOX_PURCHASE_URL=https://manager.smplystore.com/api/v1/iou/purchase
# AFYAX_PRODUCTION_PURCHASE_URL=https://vendor.afyax.health/api/v1/iou/purchase
# AFYAX_SANDBOX_LIFECYCLE_URL=   # ask Sule — iou.created, payment_updated, etc.
# AFYAX_DEFAULT_PAYMENT_METHOD=bank
# AFYAX_ACTIVE_ENV=sandbox
# Platform credentials (generate in Admin; store in local .env only — never commit)
# AFYAX_PLATFORM_NAME=AfyaX
# AFYAX_PLATFORM_ORG_ID=
# AFYAX_PLATFORM_PARTY_ID=
# AFYAX_PLATFORM_API_KEY=
# IOUX_API_BASE_URL=http://localhost:8787/api/v1

# ============ Portal (Vite) ============
VITE_API_URL=https://api.ioux.africa
VITE_SHOW_DEMO=false
VITE_ENABLE_WALLET=false
VITE_ENABLE_ENGINE=false

# ============ Supabase ops ============
# 1. npx supabase login
# 2. Create/link IOU Exchange project (dashboard: https://supabase.com/dashboard/project/<ref>)
# 3. Put pooler DATABASE_URL in .env.supabase (gitignored)
# 4. npm run db:setup:supabase
# Dashboard backups: Project Settings → Database → Backups (Pro) or nightly pg_dump cron
